# Public Firebase client configuration used by the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: set this when using a non-default Firestore Native-mode database.
VITE_FIREBASE_DATABASE_ID=
# Optional: only needed if Firebase Analytics is enabled.
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK values are server-only Replit environment secrets.
# FIREBASE_PROJECT_ID
# FIREBASE_CLIENT_EMAIL
# FIREBASE_PRIVATE_KEY
# Optional: required when the Native-mode database is not named "(default)".
# FIREBASE_DATABASE_ID